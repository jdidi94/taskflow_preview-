# Admin app — production build-time env (Vite)
# These values are baked in by `vite build`.

VITE_APP_NAME=TaskFlow Admin
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=

VITE_ENABLE_ADMIN_FEATURES=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_DEBUG_MODE=false

VITE_ENABLE_POWERBI=false
VITE_POWERBI_CLIENT_ID=
VITE_POWERBI_TENANT_ID=
VITE_POWERBI_WORKSPACE_ID=
