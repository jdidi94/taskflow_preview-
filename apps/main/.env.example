# Main app (Vite) — copy to apps/main/.env
# Only VITE_* vars are exposed to the browser.

VITE_APP_NAME=TaskFlow
VITE_API_BASE_URL=http://localhost:3001/api
VITE_SOCKET_URL=http://localhost:3001
VITE_BASE_URL=http://localhost:5173

# OAuth client IDs (public) — same apps as backend callbacks
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
# Register this callback on the GitHub OAuth App for product linking:
#   {VITE_BASE_URL}/auth/github-link-callback
# Required scopes for sync: user:email read:org repo

# Optional
VITE_ENABLE_DEBUG=true
VITE_PERSIST_SECRET=change-me-client-persist-secret
