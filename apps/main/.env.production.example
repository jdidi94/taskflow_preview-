# Main app — production build-time env (Vite)
# These values are baked in by `vite build`.

VITE_APP_NAME=TaskFlow
# Same-origin API path when your web server proxies `/api`:
VITE_API_BASE_URL=/api
# Leave empty when Socket.IO uses the page origin.
VITE_SOCKET_URL=
VITE_BASE_URL=https://app.example.com

VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_LINK_CLIENT_ID=

VITE_ENABLE_DEBUG=false
# REQUIRED for encrypted client persist — openssl rand -hex 32
VITE_PERSIST_SECRET=
