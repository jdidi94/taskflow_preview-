# Backend environment (TaskFlow AI v3)

# Copy: cp apps/backend/.env.example apps/backend/.env
# Production template: apps/backend/.env.production.example
# Never commit .env

# --- Required now (Phases 1–3 local run) ---
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5175
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

# MongoDB (required from Phase 3 onward)
DATABASE_URL=mongodb://localhost:27017/taskflow

# Demo UI data: npm run seed / npm run seed:reset  (see src/seeders/README.md)
# Login: jondoe@gmail.com / janemaria@gmail.com  password Password123!

# Auth (required when auth APIs land — Phase 3/4)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=change-me-to-another-long-random-string

# --- Optional later (Phase 4+) ---

# Email / SMTP — Gmail App Password: https://myaccount.google.com/apppasswords
# Or Mailtrap for dev: https://mailtrap.io/
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# OAuth — Google: https://console.cloud.google.com/ → Credentials → OAuth client
# GitHub: https://github.com/settings/developers → OAuth Apps
# Callback must match exactly:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
# Drive attach OAuth — add this exact URI under Google Cloud OAuth client Authorized redirect URIs
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/auth/drive-link-callback
# Enable Google Drive API + (optional) Google Picker API in Cloud Console
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
# Second OAuth App for workspace org/repo linking (classic GitHub apps allow one callback each)
GITHUB_LINK_CLIENT_ID=
GITHUB_LINK_CLIENT_SECRET=
GITHUB_LINK_CALLBACK_URL=http://localhost:5173/auth/github-link-callback

# AI — prefer free Gemini or Groq for local: https://aistudio.google.com/apikey · https://console.groq.com/keys
OPENAI_API_KEY=
GOOGLE_API_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DEFAULT_AI_PROVIDER=groq
# Optional: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Billing — Stripe Dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Power BI — Azure AD app registration
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_TENANT_ID=

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info
