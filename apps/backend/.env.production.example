# Backend — production environment
# Copy: cp apps/backend/.env.production.example apps/backend/.env

NODE_ENV=production
PORT=3001

# Public URLs — must match the URLs browsers and OAuth providers use
BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
CORS_ORIGIN=https://app.example.com,https://admin.example.com

DATABASE_URL=mongodb+srv://USER:PASS@CLUSTER/taskflow?retryWrites=true&w=majority

# REQUIRED — openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=

SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=https://app.example.com/auth/drive-link-callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://api.example.com/api/auth/github/callback
GITHUB_LINK_CLIENT_ID=
GITHUB_LINK_CLIENT_SECRET=
GITHUB_LINK_CALLBACK_URL=https://app.example.com/auth/github-link-callback

OPENAI_API_KEY=
GOOGLE_API_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DEFAULT_AI_PROVIDER=groq

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LOG_LEVEL=info
